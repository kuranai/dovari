{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dovari",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-12",
  "secrets": {
    "required": ["DOVARI_PASSWORD"],
  },
  "assets": {
    "binding": "STATIC_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/app", "/app/*", "/api/*", "/p", "/p/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dovari",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "dovari-assets",
      "remote": false,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
}
