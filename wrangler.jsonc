{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dovari",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-12",
  // DOVARI_PASSWORD is supplied by .dev.vars during local development and
  // by the Deploy to Cloudflare flow as an encrypted runtime secret. Keep it
  // out of vars and do not require it during the build step.
  "assets": {
    "binding": "STATIC_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/app",
      "/app/*",
      "/api/*",
      "/p",
      "/p/*",
      "/robots.txt",
      "/sitemap.xml",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dovari",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "dovari-assets",
      "remote": false,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "vars": {
    "DOVARI_ENV": "production",
  },
}
